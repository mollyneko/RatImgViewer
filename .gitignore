# ---------------------------------------------------------------- 依赖
node_modules/

# ---------------------------------------------------------------- 构建产物
# 安装包 / 免安装版体积很大，走 GitHub Releases 分发，不进仓库
dist/
out/
release/
build/*.blockmap

# ---------------------------------------------------------------- 本地缓存与临时文件
# .workbuddy 是本地工作数据（编译日志、注册表备份、临时探针、项目笔记），
# 属于开发机私有内容，不进公开仓库
.workbuddy/
__pycache__/
*.pyc
*.log
*.tmp
.cache/

# ---------------------------------------------------------------- 环境变量
.env
.env.*

# ---------------------------------------------------------------- 编辑器 / 系统
.vscode/
.idea/
Thumbs.db
Desktop.ini
desktop.ini
*.swp
%SystemDrive%/
